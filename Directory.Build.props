<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Analyzer suppressions justified by the DNG domain:
        CA1051 — DNG porting layer keeps POD-style public fields (n,d,t,l,b,r,v,h)
                 because that matches the on-disk layout and the C++ SDK API
                 surface; converting to properties would obscure the mapping.
        CA5351 — MD5 is mandated by the DNG file format for OriginalRawFileDigest,
                 RawDataUniqueID, etc. It is not used for security.
        CA1822 — Many SDK methods are stubs deferred to later phases; they will
                 access instance data once implemented.
        CA1062 — Public APIs are documented; null arg guards add noise to the
                 tightly-typed numeric surface.
        CA1711 — DngStream / DngFileStream / DngMemoryStream intentionally mirror
                 C++ dng_stream / dng_file_stream / dng_memory_stream names so
                 the port maps 1:1 onto the spec and reference impl.
        CA1720 — TIFF type identifiers (Short, Long, Float, Double) follow the
                 TIFF 6.0 specification; renaming would obscure spec semantics.
    -->
    <!-- CS1591 — the port is still filling in XML docs; ship the generated
         doc file without failing the build on undocumented members. -->
    <NoWarn>$(NoWarn);CA1051;CA5351;CA1822;CA1062;CA1711;CA1720;CS1591</NoWarn>

    <!-- Ship IntelliSense XML alongside the assemblies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Hot paths (pixel buffers, linearization, demosaic, color transform) use
         pointers + Span<T>. Unsafe is enabled everywhere; reserve its use for
         measured wins and keep the unsafe surface area small. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- AOT-friendly defaults; individual projects may opt out via IsAotCompatible=false -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Determinism / repro -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Version defaults. Release builds override this wholesale with
         -p:Version=<semver> (see .github/workflows/publish.yml), which sets
         AssemblyVersion / FileVersion / InformationalVersion / PackageVersion.
         Local and CI builds stay at 0.0.0-dev so an unversioned DLL is never
         mistaken for a release. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>

    <!-- Repo metadata -->
    <Company>dng-net contributors</Company>
    <Product>DngSharp.Dng.Sdk</Product>
    <Copyright>Copyright (c) dng-net contributors</Copyright>
    <RepositoryUrl>https://github.com/pathomas/dngSharp</RepositoryUrl>

    <!-- Source Link: the .NET SDK bundles Microsoft.SourceLink.GitHub, so only
         these switches are needed to make the published symbols step into the
         exact sources for a given commit. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- NuGet packaging defaults. Individual projects opt in with
         <IsPackable>true</IsPackable> + <PackageId>/<Description>. -->
    <IsPackable>false</IsPackable>
    <Authors>dng-net contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dng;dngsdk;adobe-dng;raw-image;tiff</PackageTags>
    <PackageReleaseNotes>See https://github.com/pathomas/dngSharp/releases for release notes.</PackageReleaseNotes>

    <!-- Emit a .snupkg symbol package next to the .nupkg. Portable PDBs are
         routed to the symbol package (NuGet filters .pdb out of the main
         package's lib/ folder when IncludeSymbols is set). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
