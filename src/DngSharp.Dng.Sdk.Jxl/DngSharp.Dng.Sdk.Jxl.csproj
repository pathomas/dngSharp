<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DngSharp.Dng.Sdk\DngSharp.Dng.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Not packed on its own; bundled into the single DngSharp.Dng.Sdk
         nupkg by the DngSharp.Dng.Sdk.Package meta project. -->
    <IsPackable>false</IsPackable>
    <Description>JPEG XL codec adapter for DngSharp.Dng.Sdk (P/Invokes libjxl; native runtime assets are distributed separately per-RID in the DLL zip release archives).</Description>
  </PropertyGroup>

  <!--
    Native libjxl runtime assets (libjxl 0.11.2, vendored under
    dng_sdk_1_7_1/libjxl/libjxl/).

    CI builds the shared library and places it at:
      src/DngSharp.Dng.Sdk.Jxl/runtimes/<rid>/native/<libname>

    For local development, run  tools/build-libjxl.ps1  which does the
    same thing.  When the runtimes/ directory is absent the glob below
    produces no items and the build still succeeds; JxlDecoder.IsAvailable
    will return false at runtime.

    The Link metadata flattens each file to the root of the output directory
    (e.g. bin/Release/net10.0/jxl.dll) so the OS loader finds it alongside
    the managed DLLs without any NativeLibrary.SetDllImportResolver setup.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)runtimes\**\native\*"
          Condition="Exists('$(MSBuildThisFileDirectory)runtimes')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
